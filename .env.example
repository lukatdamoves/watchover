# WatchOver Environment Configuration
# Copy this file to .env and fill in your own values:  cp .env.example .env
# NEVER commit the real .env file.

# ---- Database (MySQL) ----
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=watchover

# ---- LocationIQ (reverse geocoding) ----
# Get a free key at https://locationiq.com/
LOCATIONIQ_API_KEY=your_locationiq_api_key

# ---- SMTP (transactional email: verification + password reset) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=WatchOver

# ---- MQTT broker (Mosquitto) ----
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_WS_URL=wss://your-domain.example:9001

# ---- Web Push (VAPID) ----
# Generate a keypair with:  npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
